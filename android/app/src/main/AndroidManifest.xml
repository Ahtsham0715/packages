<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sablekey is offline. Not "does not currently make requests" — it does not
      hold the permission that would let it.

      The tools:node="remove" below is the load-bearing part: a plugin added
      three levels down the dependency tree can contribute INTERNET to the
      merged manifest without anyone noticing, and then the guarantee this app
      is built on quietly stops being true. Stripping it at merge time means
      the shipped APK cannot open a socket even if some future dependency asks
      for the right to. Run `./gradlew :app:processReleaseManifest` and read
      the merged output if you ever want to verify it.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Scanning otpauth:// QR codes. Declared optional so the app installs on
         devices without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="Sablekey"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/LaunchTheme"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!--
          allowBackup="false" is deliberate and is not an oversight to "fix".
          With it on, Android would copy the vault database to Google Drive
          under a key the user does not control, which would take the vault
          off the device and out of this app's threat model. Backups are the
          user's to make, through the encrypted .skbak export.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="false">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The activity the autofill service launches to authenticate a fill.

          excludeFromRecents and noHistory keep the credential picker out of the
          recents list, so a filled password cannot be recovered by swiping
          through recent apps afterwards.
        -->
        <activity
            android:name=".autofill.AutofillHostActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".autofill.SablekeyAutofillService"
            android:exported="true"
            android:label="Sablekey"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
      Needed to resolve the label and icon of the app being filled into, so the
      picker can say "filling into Signal" rather than showing a package name.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>
</manifest>
