<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Group is how the app hands the AutoFill extension its encrypted
	  login mirror. Both targets must carry the same identifier, and it must be
	  registered on the Apple Developer portal for the team building the app.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sablekey.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.sablekey.app</string>
	</array>
</dict>
</plist>
